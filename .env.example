OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ALLOW_DIAN_REQUESTS=true

# Solo para deploy/docker-compose.yml (no la lee la app Python).
# IP privada/VPN del servidor donde Nginx debe escuchar en :443.
# Deja 127.0.0.1 si vas a probar localmente; en el servidor real usa
# la IP interna asignada por la VPN de la empresa (nunca 0.0.0.0).
BIND_IP=127.0.0.1
