OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ALLOW_DIAN_REQUESTS=true

# Solo para deploy/docker-compose.yml (no la lee la app Python).
# IP donde Nginx debe escuchar en :8443. Si el servidor tiene una IP interna
# separada de VPN, úsala aquí para restringir el bind a esa interfaz. Si el
# servidor solo tiene una IP (como el servidor "Portal" de Logicem), deja
# 0.0.0.0 — el aislamiento real depende del firewall perimetral del
# proveedor de la nube, que debe abrir el 8443 solo para la VPN/red interna
# (igual que ya hace con los puertos 3000 y 5678 de este mismo servidor).
BIND_IP=0.0.0.0
